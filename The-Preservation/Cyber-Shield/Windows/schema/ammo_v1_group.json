{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "标准弹药 v1 群聊版",
  "type": "object",
  "required": ["version", "ammo_type", "target_account", "violation_content", "clause", "group_id"],
  "properties": {
    "version": { "type": "string", "enum": ["v1"] },
    "ammo_type": { "type": "string", "enum": ["group"] },
    "target_account": { "type": "string" },
    "target_platform": { "type": "string" },
    "violation_time": { "type": "string", "format": "date-time" },
    "violation_content": { "type": "string" },
    "clause": { "type": "string" },
    "evidence_attachments": {
      "type": "object",
      "properties": {
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "replay": { "type": "string" },
        "raw_text": { "type": "string" }
      }
    },
    "reporter_info": {
      "type": "object",
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source_app": { "type": "string" },
        "collected_at": { "type": "string", "format": "date-time" },
        "collection_method": { "type": "string" }
      }
    },
    "group_id": { "type": "string" },
    "group_name": { "type": "string" },
    "admin_info": { "type": "string" },
    "member_count": { "type": "integer" },
    "additional_context": { "type": "string" }
  }
}
